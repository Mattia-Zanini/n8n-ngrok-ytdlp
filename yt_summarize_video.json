    {
      "parameters": {
        "jsCode": "// --- CONFIGURAZIONE ---\nconst maxChars = 3800;    // Limite massimo di caratteri per singolo messaggio Telegram\nconst maxBlocks = 5;      // Numero massimo di messaggi (blocchi) da generare\nconst minThreshold = 3000; // Se il punto è prima di questa soglia, preferisce tagliare alla parola\n\n// --- RECUPERO INPUT ---\n// Prende il testo dal primo elemento dell'input (array di stringhe)\nconst fullText = $input.all()[0].json.text[0];\n// Prende l'intero oggetto Telegram dal secondo elemento per non perdere i metadati\nconst telegramFullData = $input.all()[1].json;\nconst ytTitle = $(\"GET youtube oembed\").first().json.title; // Nodo NON collegato direttamente\n\nlet blocks = [];\nlet currentPos = 0;\n\n// --- LOGICA DI SUDDIVISIONE ---\nfor (let i = 0; i < maxBlocks; i++) {\n  if (currentPos >= fullText.length) break; // Esci se il testo è finito\n\n  let endPos = currentPos + maxChars;\n\n  // Se il testo rimanente supera il limite, dobbiamo calcolare dove tagliare\n  if (endPos < fullText.length) {\n    \n    // 1. Cerca l'ultima fine di una frase (\". \" o punto e a capo)\n    let lastPoint = fullText.lastIndexOf('. ', endPos);\n    if (lastPoint === -1 || lastPoint <= currentPos) {\n        lastPoint = fullText.lastIndexOf('.\\n', endPos);\n    }\n\n    let foundGoodSentenceSplit = false;\n\n    // Se trova un punto, verifica se il blocco è abbastanza lungo (efficienza)\n    if (lastPoint > currentPos) {\n      let chunkLength = lastPoint - currentPos + 1;\n      if (chunkLength >= minThreshold) {\n        endPos = lastPoint + 1; // Taglio impostato al punto\n        foundGoodSentenceSplit = true;\n      }\n    }\n\n    // 2. FALLBACK: Se non c'è un punto o è troppo lontano, taglia all'ultimo spazio (parola intera)\n    if (!foundGoodSentenceSplit) {\n      const lastSpace = fullText.lastIndexOf(' ', endPos);\n      if (lastSpace > currentPos) {\n        endPos = lastSpace;\n      }\n    }\n  }\n\n  // Estrae il pezzo di testo e rimuove spazi inutili ai bordi\n  const chunk = fullText.substring(currentPos, endPos).trim();\n  \n  if (chunk.length > 0) {\n    // Crea l'output unendo i dati originali di Telegram con il nuovo contenuto del chunk\n    blocks.push({\n      ...telegramFullData,\n      chunk_content: chunk,\n      video_title: ytTitle, // titolo del video\n      block_index: i + 1\n    });\n  }\n\n  // Sposta l'indice di partenza per il prossimo blocco\n  currentPos = endPos;\n}\n\nreturn blocks;"
      },
